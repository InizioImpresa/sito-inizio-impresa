---
// Guscio comune di tutte le pagine: caratteri, colori, testata, piede.
// I codici di tracciamento (Tag Manager e pixel Meta) sono gli stessi del sito
// WordPress e partono SOLO sul sito vero (SITO_VERO=1), mai sull'indirizzo di prova.
// Da decidere prima del passaggio: il banner dei cookie che sostituisce Complianz.
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Testata from '../components/Testata.astro';
import Piede from '../components/Piede.astro';

interface Props {
  titolo: string;
  descrizione?: string;
}
const { titolo, descrizione = '' } = Astro.props;
const vero = process.env.SITO_VERO === '1';
const base = import.meta.env.BASE_URL;
const GTM = 'GTM-NFZRRCSM';
const PIXEL_META = '732045139609308';
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo}</title>
    {descrizione && <meta name="description" content={descrizione} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href={base + 'favicon.png'} />
    <link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'} />
    <meta property="og:title" content={titolo} />
    {descrizione && <meta property="og:description" content={descrizione} />}
    <meta property="og:locale" content="it_IT" />
    {!vero && <meta name="robots" content="noindex, nofollow" />}
    {vero && (
      <script is:inline define:vars={{ GTM }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',GTM);
      </script>
    )}
    {vero && (
      <script is:inline define:vars={{ PIXEL_META }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', PIXEL_META); fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body>
    {!vero && <div class="avviso-prova">Indirizzo di prova del nuovo sito: il sito vero resta inizioimpresa.it</div>}
    <Testata />
    <main>
      <slot />
    </main>
    <Piede />
  </body>
</html>

<style is:global>
  .avviso-prova { background: #fff3c4; color: #5a4500; text-align: center; padding: 6px 16px; font-size: 13px; }
</style>
