---
import { Image } from 'astro:assets';
import logo from '../assets/logo-inizio.png';
import { contatti, menu } from '../data/sito';
const base = import.meta.env.BASE_URL;
---
<footer class="piede">
  <div class="contenitore colonne">
    <div>
      <Image src={logo} alt="Inizio" width={120} height={47} />
      <p class="motto">Partner d'impresa. Finanza agevolata e finanza ordinaria per le PMI italiane.</p>
    </div>
    <div>
      <h3>Soluzioni</h3>
      <ul>{menu.map((v) => <li><a href={base + v.href}>{v.testo}</a></li>)}</ul>
    </div>
    <div>
      <h3>Marketing</h3>
      <ul>
        <li><a href={base + 'marketing/'}>Marketing</a></li>
        <li><a href={base + 'wedding-marketing/'}>Wedding Marketing</a></li>
      </ul>
    </div>
    <div>
      <h3>Contatti</h3>
      <ul>
        <li><a href={`mailto:${contatti.email}`}>{contatti.email}</a></li>
        <li><a href={contatti.telefonoLink}>{contatti.telefono}</a></li>
        <li>{contatti.indirizzo}</li>
      </ul>
    </div>
  </div>
  <div class="contenitore legale">
    <p>{contatti.societa} · {contatti.sede} · P.IVA {contatti.piva}</p>
    <p>
      <a href={base + 'privacy-policy/'}>Privacy policy</a> ·
      <a href={base + 'cookie-policy/'}>Cookie policy</a>
    </p>
  </div>
</footer>

<style>
  .piede { border-top: 1px solid var(--bordo); padding: 64px 0 28px; font-size: 15px; }
  .colonne { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; }
  .piede img { width: 120px; height: auto; }
  .motto { margin-top: 16px; max-width: 300px; }
  .piede h3 { font-size: 14px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 14px; }
  .piede ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .piede a { text-decoration: none; }
  .piede a:hover { color: var(--rosso); }
  .legale {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px;
    margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--bordo); font-size: 13px;
  }
  @media (max-width: 860px) { .colonne { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .colonne { grid-template-columns: 1fr; } }
</style>
