---
// Le imprese che si sono affidate a Inizio, con la foto vera della loro attività.
import { Image } from 'astro:assets';
import { storie } from '../data/sito';
interface Props {
  titolo?: string;
  testo?: string;
  solo?: string[]; // nomi da mostrare; se manca, tutte
}
const { titolo = 'Aziende che si sono affidate a noi', testo = '', solo } = Astro.props;
const elenco = solo ? storie.filter((s) => solo.includes(s.nome)) : storie;
---
<section class="sezione">
  <div class="contenitore">
    <div class="testata">
      <span class="occhiello">Storie di successo</span>
      <h2>{titolo}</h2>
      {testo && <p>{testo}</p>}
    </div>
    <ul class="storie" role="list">
      {elenco.map((s) => (
        <li class="storia">
          <Image src={s.foto} alt={`L'attività di ${s.nome}`} widths={[300, 560]} sizes="(max-width: 640px) 80vw, 280px" />
          <div class="didascalia">
            <h3>{s.nome}</h3>
            <span>{s.misura}</span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .storie {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(240px, 1fr);
    gap: 20px; list-style: none; margin: 0; padding: 0 0 12px;
    overflow-x: auto; scroll-snap-type: x mandatory;
  }
  .storia {
    position: relative; scroll-snap-align: start; border-radius: var(--raggio); overflow: hidden;
    aspect-ratio: 4 / 5; background: var(--sfondo-tenue);
  }
  .storia img { width: 100%; height: 100%; object-fit: cover; }
  .didascalia {
    position: absolute; left: 12px; right: 12px; bottom: 12px;
    background: rgba(255, 255, 255, 0.95); border-radius: var(--raggio-piccolo); padding: 14px 16px;
  }
  .didascalia h3 { font-size: 16px; }
  .didascalia span { font-size: 13px; color: var(--rosso-scuro); font-weight: 600; }
  @media (min-width: 1100px) { .storie { grid-auto-columns: calc((100% - 60px) / 4); } }
</style>
