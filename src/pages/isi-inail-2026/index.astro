---
// LANDING BANDO ISI INAIL 2026. Testi dal vecchio sito (contenuti-originali/isi-inail-2026.md).
// Nel vecchio sito questa pagina era quasi tutta copiata dalla ZES 2026 (conto alla rovescia,
// requisiti, spese, passi e FAQ della ZES, blocchi del microcredito, "99 consulenze"):
// qui resta solo cio' che riguarda davvero l'ISI INAIL. Il modulo e' lo stesso della ZES,
// come sul vecchio sito.
// Il dato "63+ progetti ISI INAIL approvati" viene dalla pagina "Sei un commercialista?"
// del vecchio sito (sezione "Inizio Impresa negli ultimi 3 anni").
import Base from '../../layouts/Base.astro';
import Modulo from '../../components/Modulo.astro';
import Numeri from '../../components/Numeri.astro';
import Storie from '../../components/Storie.astro';
import Perche from '../../components/Perche.astro';

const finanzia = [
  {
    titolo: 'Macchinari e attrezzature nuovi',
    testo: "L'acquisto di nuove attrezzature di lavoro e di macchinari innovativi per la tua attività.",
    icona: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/>',
  },
  {
    titolo: 'Al posto di quelli obsoleti',
    testo: "I nuovi beni sostituiscono macchinari e attrezzature vecchi, già in possesso dell'impresa.",
    icona: '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>',
  },
  {
    titolo: 'Più salute e sicurezza',
    testo: 'Gli investimenti devono migliorare le condizioni di salute e sicurezza dei lavoratori nei luoghi di lavoro.',
    icona: '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
  },
];

const passi = [
  { titolo: 'Verifica iniziale', testo: 'Analisi di prefattibilità gratuita: controlliamo se la tua impresa e il tuo investimento possono rientrare nel bando.' },
  { titolo: 'Documentazione', testo: 'Prepariamo insieme a te tutta la documentazione necessaria per la domanda.' },
  { titolo: 'Invio della pratica', testo: 'Presentiamo la domanda e ti seguiamo in ogni fase, con un consulente dedicato.' },
];
---
<Base
  titolo="Bando ISI INAIL 2026 · Fino a 130.000 € a fondo perduto · Inizio Impresa"
  descrizione="Devi sostituire macchinari o attrezzature obsolete? Con il bando ISI INAIL puoi ottenere un contributo a fondo perduto del 65%, fino a 130.000 €. Prefattibilità gratuita con Inizio Impresa."
>
  <!-- APERTURA -->
  <section class="apertura">
    <div class="contenitore apertura-griglia">
      <div>
        <span class="pillola">130.000 € a fondo perduto</span>
        <h1>Bando ISI INAIL <span class="evidenza">2026</span></h1>
        <p class="sottotitolo">
          Devi sostituire macchinari o attrezzature obsolete? Con il bando ISI INAIL puoi ottenere
          fino a <strong>130.000 € a fondo perduto</strong> per la tua attività.
        </p>
        <div class="azioni">
          <a href="#modulo" class="bottone bottone--pieno">Richiedi la prefattibilità gratuita</a>
          <a href="https://wa.me/393200831910" class="collegamento" rel="noopener">Scrivici su WhatsApp →</a>
        </div>
        <ul class="spunte">
          <li>Analisi di prefattibilità gratuita</li>
          <li>0 € di spese istruttorie</li>
        </ul>
      </div>
      <div class="cifre" aria-label="Il bando in breve">
        <div class="cifra cifra--grande"><strong>65%</strong><span>contributo a fondo perduto</span></div>
        <div class="cifra"><strong>130.000 €</strong><span>contributo massimo</span></div>
        <div class="cifra"><strong>63+</strong><span>progetti ISI INAIL approvati con noi negli ultimi 3 anni</span></div>
        <div class="cifra cifra--scura"><strong>Sicurezza</strong><span>macchinari nuovi al posto di quelli obsoleti, per la salute dei lavoratori</span></div>
      </div>
    </div>
  </section>

  <!-- DI COSA SI TRATTA -->
  <section class="sezione sezione--tenue">
    <div class="contenitore testata testata--centro" style="margin-bottom:0">
      <span class="occhiello">Di cosa si tratta</span>
      <h2>Un contributo per lavorare in <span class="evidenza">sicurezza</span>.</h2>
      <p>
        ISI INAIL è l'incentivo che sostiene le imprese nell'acquisto di nuove attrezzature di lavoro
        e macchinari innovativi, in sostituzione di quelli obsoleti, per migliorare la salute e la
        sicurezza dei lavoratori. Il bando riconosce un contributo a fondo perduto del 65%, fino a un
        massimo di 130.000 €.
      </p>
    </div>
  </section>

  <!-- COSA FINANZIA -->
  <section class="sezione">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Cosa posso acquistare?</span>
        <h2>Cosa finanzia il bando</h2>
        <p>Nuovi investimenti aziendali pensati per rendere più sicuro il posto di lavoro.</p>
      </div>
      <div class="griglia griglia--3">
        {finanzia.map((f) => (
          <div class="scheda">
            <div class="icona"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icona} /></div>
            <h3>{f.titolo}</h3>
            <p>{f.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COME TI SEGUIAMO -->
  <section class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Come lavoriamo</span>
        <h2>Ti seguiamo in ogni fase</h2>
        <p>Dalla verifica iniziale fino alla preparazione dei documenti e all'invio della pratica.</p>
      </div>
      <ol class="linea">
        {passi.map((p, i) => (
          <li>
            <span class="tondo">{i + 1}</span>
            <div>
              <h3>{p.titolo}</h3>
              <p>{p.testo}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Storie
    titolo="Alcuni dei nostri risultati"
    testo="Alcune delle attività che ci hanno scelto: Tipografia Ariello ed Edil System hanno ottenuto il Bando ISI INAIL 2023."
  />

  <!-- OFFERTA -->
  <section class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="offerta">
        <div>
          <span class="occhiello occhiello--chiaro">Solo per un numero limitato di aziende al mese</span>
          <h2>Risparmia 500 € sulle spese istruttorie.</h2>
          <p>
            Prenota ora la tua analisi di prefattibilità, gratuita e senza impegno: spese istruttorie
            a 0 € anziché 500 €.
          </p>
        </div>
        <a href="#modulo" class="bottone bottone--chiaro">Prenota adesso</a>
      </div>
    </div>
  </section>

  <Numeri />

  <Perche testo="Partiamo da una prefattibilità gratuita per verificare requisiti e ammissibilità dell'investimento. Poi prepariamo la documentazione e presentiamo la domanda, seguendoti in ogni fase." />

  <Modulo
    id="DqayKwvDxBYf5edv4OsG"
    nome="Modulo Sito Inizio Impresa - ZES 2026"
    titolo="Richiedi una prefattibilità gratuita"
    testo="Compila il modulo: verifichiamo se il tuo investimento può rientrare nel bando ISI INAIL."
  >
    <p class="whatsapp">Preferisci scriverci? <a href="https://wa.me/393200831910" rel="noopener">WhatsApp</a></p>
  </Modulo>
</Base>

<style>
  .apertura { padding: 72px 0 88px; }
  .apertura-griglia { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .apertura h1 { margin: 20px 0; font-size: clamp(40px, 6.4vw, 68px); }
  .sottotitolo { font-size: 18px; max-width: 520px; }
  .sottotitolo strong { color: var(--testo); }
  .azioni { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin: 32px 0 20px; }

  .cifre {
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 32px;
    border-radius: 28px; background: linear-gradient(160deg, #fdf3f3 0%, #f1f2f7 100%);
  }
  .cifra {
    background: #fff; border: 1px solid var(--bordo); border-radius: 16px; padding: 20px;
    box-shadow: var(--ombra); display: flex; flex-direction: column; gap: 4px; font-size: 14px;
    min-width: 0;
  }
  .cifra strong { font-family: var(--font-titoli); font-weight: 600; font-size: 24px; color: var(--testo); line-height: 1.1; }
  .cifra--grande { grid-column: 1 / -1; }
  .cifra--grande strong { font-size: 56px; color: var(--rosso); }
  .cifra--scura { grid-column: 1 / -1; background: var(--notte); border-color: var(--notte); color: #c9cad6; }
  .cifra--scura strong { color: #fff; }

  .linea { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .linea li { display: flex; gap: 16px; align-items: flex-start; }
  .linea h3 { margin-bottom: 8px; }
  .tondo {
    flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--rosso); color: #fff; font-family: var(--font-titoli); font-weight: 600;
  }

  .offerta {
    display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;
    padding: 48px; border-radius: 28px; background: var(--rosso); color: #fff;
  }
  .offerta > div { max-width: 640px; }
  .offerta h2 { color: #fff; }
  .offerta p { margin-top: 14px; color: #fff3f3; font-size: 17px; }
  .occhiello--chiaro { color: #ffe1e1; }

  .whatsapp { margin-top: 24px; }
  .whatsapp a { color: var(--rosso); font-weight: 600; }

  @media (max-width: 960px) {
    .apertura-griglia { grid-template-columns: 1fr; gap: 40px; }
    .apertura { padding: 48px 0 64px; }
    .linea { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .cifre { padding: 18px; }
    .cifra { padding: 16px; }
    .cifra strong { font-size: 21px; }
    .cifra--grande strong { font-size: 48px; }
    .offerta { padding: 32px 24px; }
  }
</style>
