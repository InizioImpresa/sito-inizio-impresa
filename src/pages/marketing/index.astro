---
// MARKETING. Testi dal vecchio sito (contenuti-originali/marketing.md), accorciati e riordinati.
// La pagina /wedding-marketing/ sul vecchio sito ha gli stessi identici contenuti: qui è
// rifatta uguale in src/pages/wedding-marketing/index.astro (cambia solo il titolo della pagina).
// Se cambi una delle due, cambia anche l'altra.
// Tolti: il video YouTube incorporato, il testo "grassetto unicode", la sezione "Dove siamo"
// con il numero fisso 0823 1658588, la slide "I conti" del case history (era un esempio
// "supponendo", non un risultato), i refusi ("ottenre", "consulnte", "l tuo partner").
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Modulo from '../../components/Modulo.astro';
import provaMeta from '../../assets/marketing/prova-meta-ads.png';
import provaGoogle from '../../assets/marketing/prova-google-ads.png';
import provaEmail from '../../assets/marketing/prova-email.png';
import provaWhatsapp from '../../assets/marketing/prova-whatsapp.png';
import logoKlu from '../../assets/marketing/logo-klu.png';
import logoColomba from '../../assets/marketing/logo-colomba-doro.png';
import logoSfr from '../../assets/marketing/logo-sfr.png';

const servizi = [
  {
    titolo: 'Strategie di marketing online',
    testo:
      'Analizziamo il tuo mercato, il comportamento del target e la concorrenza. Costruiamo una strategia completa su misura per la tua azienda, per acquisire clienti e crescere in modo stabile e misurabile.',
    icona: '<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 6-6"/>',
  },
  {
    titolo: 'Campagne social: gestione e analisi',
    testo:
      "Seguiamo tutto il ciclo: dalla creazione dei contenuti alla pubblicazione, dal monitoraggio all'ottimizzazione continua delle campagne Meta e Google, con dati e KPI reali.",
    icona: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
  },
  {
    titolo: 'Funnel marketing',
    testo:
      "Percorsi personalizzati che portano il potenziale cliente dal primo contatto alla decisione d'acquisto: attrazione, coinvolgimento, conversione e fidelizzazione, con pubblicità, landing page e CRM.",
    icona: '<path d="M3 4h18l-7 9v6l-4 2v-8z"/>',
  },
  {
    titolo: 'WhatsApp ed email marketing',
    testo:
      "Sequenze automatiche di email e messaggi WhatsApp che tengono vivo il rapporto con il cliente e lo spingono all'azione, con contenuti e tempi adattati al suo comportamento.",
    icona: '<path d="M21 12a8 8 0 0 1-11.8 7L4 20l1-5A8 8 0 1 1 21 12z"/>',
  },
  {
    titolo: 'Google Ads',
    testo:
      'Campagne per intercettare chi sta cercando proprio ciò che offri: parole chiave mirate, annunci efficaci e landing page ottimizzate, per ridurre il costo per acquisizione e aumentare le vendite.',
    icona: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/>',
  },
  {
    titolo: 'Landing page',
    testo:
      "Pagine studiate per trasformare i visitatori in contatti o clienti: testi chiari, design orientato agli obiettivi e inviti all'azione ben posizionati.",
    icona: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 14h8"/>',
  },
];

const strategia = ['Inserzioni Facebook e Instagram', 'Landing page dedicata', 'Messaggio WhatsApp automatico', 'Email automatiche'];

const prove = [
  { foto: provaMeta, alt: 'Gestione inserzioni Meta: risultati e costo per contatto delle campagne', didascalia: 'Campagne Meta: costo per contatto' },
  { foto: provaGoogle, alt: 'Pannello Google Ads: clic, CTR, impressioni e costo del mese', didascalia: 'Google Ads: clic e CTR' },
  { foto: provaEmail, alt: 'Email automatiche: tassi di apertura e di clic', didascalia: 'Email automatiche: aperture e clic' },
  { foto: provaWhatsapp, alt: 'Messaggio WhatsApp automatico inviato a un contatto appena arrivato', didascalia: 'WhatsApp automatico al nuovo contatto' },
];

const clienti = [
  { nome: 'KLU Pizza Club', luogo: 'Roma Prati', logo: logoKlu },
  { nome: "Colomba d'Oro Eventi", luogo: 'Castel Volturno (CE)', logo: logoColomba },
  { nome: 'La Locanda del Carrubo', luogo: 'Mattinata (FG)', logo: null },
  { nome: 'COSO Ristorante', luogo: 'Roma', logo: null },
  { nome: 'SFR Motors', luogo: 'Roma', logo: logoSfr },
  { nome: 'Liccardo Impianti', luogo: 'Napoli', logo: null },
];

const noi = [
  'Un consulente dedicato sempre al tuo fianco',
  'Campagne Google Ads e Instagram per massimizzare i risultati',
  'Marketing automation con i nostri software interni (WhatsApp, email, CRM)',
];
const altri = [
  'Pochi risultati concreti',
  'Nessuna automazione: tutto resta manuale e lento, sei uno dei tanti clienti',
  'Nessuna pubblicità su Google',
  'Pacchetti standard uguali per tutti e nessun consulente dedicato',
];

const domande = [
  {
    domanda: "La mia azienda è in un'altra regione: posso lavorare con voi?",
    risposta:
      'Certo. Collaboriamo con aziende in tutta Italia e gestiamo i progetti anche da remoto, con call, messaggi e report costanti. Ovunque ti trovi, avrai supporto dedicato e la stessa qualità di servizio.',
  },
  {
    domanda: 'In cosa consiste il vostro supporto a 360°?',
    risposta:
      "Hai un consulente dedicato che conosce la tua azienda e ti segue passo passo. Oltre alle campagne su Facebook e Google Ads, per alcuni clienti gestiamo anche annunci per la ricerca di personale, l'aggiornamento dei menù digitali dei ristoranti, brochure e materiali grafici. E con i nostri software interni integriamo WhatsApp ed email automatiche, per trasformare più facilmente i contatti in opportunità concrete.",
  },
  {
    domanda: "Mi sono già affidato a un'agenzia senza risultati: perché dovrei fidarmi di voi?",
    risposta:
      'Capita spesso. Lavoriamo su obiettivi concreti e misurabili, con report chiari, così sai sempre cosa stai ottenendo. Hai un consulente dedicato, campagne non solo su Facebook ma anche su Google Ads e strumenti di marketing automation che trasformano i contatti in opportunità reali.',
  },
  {
    domanda: 'Quanto devo investire per lavorare con voi?',
    risposta:
      "Non c'è un costo fisso uguale per tutti. In generale i nostri clienti investono tra 800 e 1.500 € al mese per il nostro supporto, a cui si aggiunge il budget pubblicitario speso direttamente sulle piattaforme come Facebook o Google. L'importo varia in base agli obiettivi e alla complessità del progetto.",
  },
  {
    domanda: 'In quanto tempo vedo i primi risultati?',
    risposta:
      'Dipende dal tipo di attività e di campagne. In genere iniziamo a generare contatti qualificati già nelle prime settimane, ma puntiamo a risultati stabili e misurabili nel medio periodo. Ti aggiorniamo costantemente con report chiari.',
  },
];
---
<Base
  titolo="Marketing per le aziende · Campagne Meta e Google Ads · Inizio Impresa"
  descrizione="Campagne Facebook, Instagram e Google Ads, landing page, funnel e automazioni WhatsApp ed email per ricevere contatti reali. Consulente dedicato e prova gratuita."
>
  <!-- APERTURA -->
  <section class="apertura">
    <div class="contenitore apertura-griglia">
      <div>
        <span class="pillola">Digital marketing per la tua azienda</span>
        <h1>Fatti trovare da chi sta cercando <span class="evidenza">proprio te</span>.</h1>
        <p class="sottotitolo">
          Hai già investito in pubblicità su Facebook o Google senza vedere risultati? Il problema non è
          "fare le ads", ma saperle far funzionare. Con noi smetti di sprecare soldi e inizi a ricevere
          <strong>contatti reali, interessati e pronti a comprare</strong>.
        </p>
        <div class="azioni">
          <a href="#modulo" class="bottone bottone--pieno">Richiedi una prova gratuita</a>
          <a href="#case-history" class="collegamento">Guarda i risultati →</a>
        </div>
        <ul class="spunte">
          <li>Consulente dedicato</li>
          <li>Meta e Google Ads</li>
          <li>WhatsApp ed email automatiche</li>
        </ul>
      </div>
      <div class="cifre" aria-label="Case history: La Locanda del Carrubo">
        <div class="cifra cifra--intera cifra--etichetta">
          <span>Case history · La Locanda del Carrubo</span>
        </div>
        <div class="cifra cifra--intera cifra--grande"><strong>13 matrimoni</strong><span>in più per la stagione 2024</span></div>
        <div class="cifra"><strong>210</strong><span>contatti ricevuti</span></div>
        <div class="cifra"><strong>53</strong><span>visite in struttura</span></div>
        <div class="cifra cifra--intera cifra--scura"><strong>1.965,82 €</strong><span>di budget pubblicitario in tutto</span></div>
      </div>
    </div>
  </section>

  <!-- IL PROBLEMA -->
  <section class="sezione sezione--tenue">
    <div class="contenitore testata testata--centro" style="margin-bottom:0">
      <span class="occhiello">Il nostro metodo</span>
      <h2>Il problema non è quanto spendi, ma <span class="evidenza">come</span> investi.</h2>
      <p>
        Ogni campagna nasce con un obiettivo chiaro: portarti contatti qualificati. Non clic inutili, ma
        persone realmente interessate che ti lasciano i loro dati e vogliono parlare con te. Seguiamo i
        risultati passo dopo passo, ottimizziamo le campagne mentre sono attive e trasformiamo la pubblicità
        in un flusso costante di contatti pronti a diventare clienti.
      </p>
    </div>
  </section>

  <!-- SERVIZI -->
  <section class="sezione">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Metodo collaudato e strumenti integrati</span>
        <h2>I nostri servizi</h2>
      </div>
      <div class="griglia griglia--3">
        {servizi.map((s) => (
          <div class="scheda">
            <div class="icona"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icona} /></div>
            <h3>{s.titolo}</h3>
            <p>{s.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE HISTORY -->
  <section id="case-history" class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Alcuni dei nostri lavori</span>
        <h2>Case history: La Locanda del Carrubo</h2>
        <p>
          Boutique Resort &amp; Spa a Mattinata (FG). L'obiettivo: aumentare gli eventi, in particolare i
          matrimoni, per la stagione 2024.
        </p>
      </div>
      <div class="caso">
        <div class="scheda">
          <h3>La strategia</h3>
          <ul class="strategia">
            {strategia.map((s) => <li>{s}</li>)}
          </ul>
          <p class="caso-nota">
            Le coppie che lasciavano il contatto ricevevano subito un messaggio WhatsApp della location
            (grazie al nostro software interno) e una serie di email per conoscere la struttura e fissare una visita.
          </p>
        </div>
        <ol class="imbuto" aria-label="Risultati della campagna">
          <li><strong>125.088</strong><span>persone raggiunte dalle inserzioni</span></li>
          <li><strong>210</strong><span>contatti nel raggio di 40 km</span></li>
          <li><strong>53</strong><span>appuntamenti in struttura</span></li>
          <li><strong>13</strong><span>matrimoni, con 1.965,82 € di pubblicità</span></li>
        </ol>
      </div>
      <blockquote class="parere">
        <p>
          "Grazie alle loro strategie mirate, lo scorso anno abbiamo incrementato significativamente il numero
          di eventi, raggiungendo nuovi clienti a costi contenuti."
        </p>
        <cite>La Locanda del Carrubo</cite>
      </blockquote>

      <h3 class="prove-titolo">Dai nostri account, senza filtri</h3>
      <ul class="prove" role="list">
        {prove.map((p) => (
          <li>
            <figure>
              <Image src={p.foto} alt={p.alt} widths={[480, 960]} sizes="(max-width: 640px) 100vw, 540px" />
              <figcaption>{p.didascalia}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CLIENTI -->
  <section class="sezione">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Chi ci ha scelto</span>
        <h2>Alcune attività che ci hanno scelto</h2>
      </div>
      <ul class="griglia griglia--3 clienti" role="list">
        {clienti.map((c) => (
          <li class="cliente">
            {c.logo ? (
              <Image src={c.logo} alt={`Logo ${c.nome}`} width={64} height={64} class="cliente-logo" />
            ) : (
              <span class="cliente-sigla" aria-hidden="true">{c.nome.replace(/^(La|Il) /, '').charAt(0)}</span>
            )}
            <div>
              <h3>{c.nome}</h3>
              <span>{c.luogo}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PERCHÉ NOI -->
  <section class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Il tuo partner per la crescita</span>
        <h2>Perché scegliere noi fa la differenza</h2>
        <p>
          Molte agenzie gestiscono qualche campagna e ti mandano un report a fine mese. Noi diventiamo il tuo
          partner digitale: ti seguiamo a 360° con un consulente dedicato, lavoriamo anche su Google Ads per
          intercettare i clienti nel momento in cui cercano i tuoi servizi, e con i nostri software interni
          automatizziamo WhatsApp ed email, così tu ti concentri sul tuo lavoro.
        </p>
      </div>
      <div class="confronto">
        <div class="scheda confronto-noi">
          <h3>Marketing con Inizio Impresa</h3>
          <ul class="lista lista--si">{noi.map((v) => <li>{v}</li>)}</ul>
          <a href="#modulo" class="bottone bottone--chiaro">Richiedi la consulenza gratuita</a>
        </div>
        <div class="scheda">
          <h3>Marketing con altre agenzie</h3>
          <ul class="lista lista--no">{altri.map((v) => <li>{v}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DOMANDE -->
  <section class="sezione">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">I tuoi dubbi, le nostre risposte</span>
        <h2>Domande frequenti</h2>
      </div>
      <div class="domande">
        {domande.map((d) => (
          <details class="domanda">
            <summary>{d.domanda}</summary>
            <p>{d.risposta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Modulo
    id="ikoErRRe2f1nFesaEs0g"
    nome="Modulo Sito Inizio Impresa - Marketing"
    titolo="Richiedi un periodo di prova gratuito"
    testo="Compila il modulo con i tuoi dati: troviamo insieme le soluzioni di marketing più adatte per far crescere la tua azienda, e provi il servizio per vedere i risultati."
  />
</Base>

<style>
  .apertura { padding: 72px 0 88px; }
  .apertura-griglia { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .apertura h1 { margin: 20px 0; }
  .sottotitolo { font-size: 18px; max-width: 540px; }
  .sottotitolo strong { color: var(--testo); }
  .azioni { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin: 32px 0 20px; }

  .cifre {
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 32px;
    border-radius: 28px; background: linear-gradient(160deg, #fdf3f3 0%, #f1f2f7 100%);
  }
  .cifra {
    background: #fff; border: 1px solid var(--bordo); border-radius: 16px; padding: 20px;
    box-shadow: var(--ombra); display: flex; flex-direction: column; gap: 4px; font-size: 14px;
  }
  .cifra strong { font-family: var(--font-titoli); font-weight: 600; font-size: 28px; color: var(--testo); line-height: 1.1; }
  .cifra--intera { grid-column: 1 / -1; }
  .cifra--etichetta {
    background: transparent; border: 0; box-shadow: none; padding: 0 4px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--rosso-scuro);
  }
  .cifra--grande strong { font-size: 44px; color: var(--rosso); }
  .cifra--scura { background: var(--notte); border-color: var(--notte); color: #c9cad6; }
  .cifra--scura strong { color: #fff; }

  .caso { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: stretch; }
  .strategia { list-style: none; margin: 8px 0 18px; padding: 0; display: grid; gap: 10px; }
  .strategia li { display: flex; gap: 10px; align-items: center; color: var(--testo); font-weight: 500; }
  .strategia li::before { content: ''; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--rosso); }
  .caso-nota { font-size: 15px; }

  .imbuto { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .imbuto li {
    display: flex; align-items: baseline; gap: 14px; padding: 16px 22px; border-radius: var(--raggio-piccolo);
    background: #fff; border: 1px solid var(--bordo);
  }
  .imbuto li:nth-child(2) { margin: 0 4%; }
  .imbuto li:nth-child(3) { margin: 0 8%; }
  .imbuto li:nth-child(4) { margin: 0 12%; background: var(--rosso); border-color: var(--rosso); color: #fff3f3; }
  .imbuto strong { font-family: var(--font-titoli); font-weight: 600; font-size: 26px; color: var(--testo); line-height: 1; }
  .imbuto li:nth-child(4) strong { color: #fff; }

  .parere { margin: 28px 0 0; padding: 24px 28px; border-left: 4px solid var(--rosso); background: #fff; border-radius: 0 var(--raggio-piccolo) var(--raggio-piccolo) 0; }
  .parere p { font-size: 18px; color: var(--testo); font-style: italic; }
  .parere cite { display: block; margin-top: 10px; font-style: normal; font-weight: 600; font-size: 14px; color: var(--rosso-scuro); }

  .prove-titolo { margin: 56px 0 20px; font-size: 22px; }
  .prove { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; list-style: none; margin: 0; padding: 0; }
  .prove figure { margin: 0; background: #fff; border: 1px solid var(--bordo); border-radius: var(--raggio); overflow: hidden; }
  .prove img { width: 100%; aspect-ratio: 1920 / 1400; object-fit: cover; object-position: top; }
  .prove figcaption { padding: 14px 18px; font-size: 14px; font-weight: 600; color: var(--testo); border-top: 1px solid var(--bordo); }

  .clienti { list-style: none; margin: 0; padding: 0; }
  .cliente {
    display: flex; align-items: center; gap: 16px; padding: 18px 20px;
    background: #fff; border: 1px solid var(--bordo); border-radius: var(--raggio);
  }
  .cliente h3 { font-size: 16px; }
  .cliente span { font-size: 14px; }
  .cliente-logo { flex: none; width: 64px; height: 64px; border-radius: var(--raggio-piccolo); object-fit: cover; border: 1px solid var(--bordo); }
  .cliente-sigla {
    flex: none; width: 64px; height: 64px; border-radius: var(--raggio-piccolo); display: grid; place-items: center;
    background: var(--rosso-chiaro); color: var(--rosso); font-family: var(--font-titoli); font-weight: 600; font-size: 26px;
  }

  .confronto { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .confronto h3 { margin-bottom: 18px; }
  .confronto-noi { background: var(--notte); border-color: var(--notte); color: #c9cad6; }
  .confronto-noi h3 { color: #fff; }
  .confronto-noi .bottone { margin-top: 24px; }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .lista li { display: flex; gap: 10px; }
  .lista li::before { flex: none; font-weight: 700; }
  .lista--si li::before { content: '✓'; color: #3ad38a; }
  .lista--no li::before { content: '✕'; color: var(--rosso); }

  .domande { display: grid; gap: 12px; max-width: 820px; }
  .domanda { background: #fff; border: 1px solid var(--bordo); border-radius: var(--raggio-piccolo); padding: 0 22px; }
  .domanda summary {
    cursor: pointer; list-style: none; padding: 18px 28px 18px 0; position: relative;
    font-family: var(--font-titoli); font-weight: 600; color: var(--testo); font-size: 16px;
  }
  .domanda summary::-webkit-details-marker { display: none; }
  .domanda summary::after {
    content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    font-size: 22px; color: var(--rosso);
  }
  .domanda[open] summary::after { content: '–'; }
  .domanda p { padding-bottom: 20px; }

  @media (max-width: 960px) {
    .apertura-griglia, .caso, .confronto { grid-template-columns: 1fr; gap: 40px; }
    .caso, .confronto { gap: 20px; }
    .apertura { padding: 48px 0 64px; }
  }
  @media (max-width: 640px) {
    .prove { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .cifre { padding: 18px; }
    .cifra--grande strong { font-size: 34px; }
    .imbuto li { flex-direction: column; gap: 4px; padding: 14px 18px; }
    .imbuto li:nth-child(n) { margin: 0; }
  }
</style>
