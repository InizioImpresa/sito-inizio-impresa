---
// LANDING "SEI UN VENDITORE?" (per chi vende beni strumentali alle aziende).
// Testi dal vecchio sito (contenuti-originali/sei-un-venditore.md), accorciati.
// Sul vecchio sito questa pagina non aveva un modulo: qui si usa quello generico della home
// (le richieste arrivano insieme a quelle della home). Tolti: i "Learn more" del tema Finpath,
// i blocchi ripetuti, i contatori fermi a zero, le recensioni dei clienti marketing,
// "Consiglia Inizio ad un amico", il blocco Instagram e il link alla guida su Bitrix24.
import Base from '../../layouts/Base.astro';
import Modulo from '../../components/Modulo.astro';
import Numeri from '../../components/Numeri.astro';
import Storie from '../../components/Storie.astro';
import Perche from '../../components/Perche.astro';

const benefici = [
  { titolo: 'Soluzioni finanziarie complete', icona: '<path d="M4 7h16M4 12h16M4 17h10"/>' },
  { titolo: 'Supporto personalizzato', icona: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>' },
  { titolo: 'Più vendite', icona: '<path d="M3 17l6-6 4 4 8-8"/><path d="M14 7h7v7"/>' },
  { titolo: 'Marketing congiunto', icona: '<path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/>' },
];

const soluzioni = [
  {
    titolo: 'Leasing strumentale',
    testo: "Il cliente acquisisce il macchinario con un canone periodico e l'opzione di riscatto finale. Tu incassi subito l'intero importo: finanzia la banca, e il cliente paga direttamente lei.",
    icona: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/>',
  },
  {
    titolo: 'Noleggio strumentale',
    testo: "Il cliente usa il macchinario per un periodo stabilito senza comprarlo. Ampli la tua offerta, rendi i macchinari più accessibili e i rinnovi continui aumentano la fidelizzazione.",
    icona: '<path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/>',
  },
  {
    titolo: 'Finanziamenti aziendali',
    testo: "Il cliente acquista i tuoi macchinari con un finanziamento con garanzia statale, erogazione rapida e il miglior tasso d'interesse sul mercato.",
    icona: '<path d="M3 21h18M5 21V10M19 21V10M9 21V10M15 21V10M2 10l10-6 10 6"/>',
  },
  {
    titolo: 'Agevolazioni a fondo perduto',
    testo: 'Aiutiamo le aziende a ottenere contributi regionali e nazionali a fondo perduto: i tuoi clienti possono usarli per acquistare i tuoi macchinari.',
    icona: '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  },
];

const motivi = [
  {
    titolo: 'Campagne pubblicitarie gratuite',
    testo: 'Creiamo per te, gratis, campagne pubblicitarie per far conoscere la tua attività e i tuoi prodotti alle aziende interessate a comprare beni strumentali.',
  },
  {
    titolo: 'Rete bancaria diversificata',
    testo: 'Collaboriamo con 42 istituti bancari: più possibilità di approvazione per finanziamenti e leasing, meno attese e più opportunità per te e i tuoi clienti.',
  },
  {
    titolo: 'Accesso diretto ai clienti',
    testo: 'Grazie alla nostra rete di collaborazioni ti indirizziamo i clienti che hanno già deciso di investire in nuovi macchinari o attrezzature.',
  },
];
---
<Base
  titolo="Sei un venditore di beni strumentali? · Inizio Impresa"
  descrizione="Vendi macchinari e attrezzature alle aziende? Offri ai tuoi clienti leasing, noleggio operativo, finanziamenti e finanza agevolata e incassa tutto subito. Collaborazione gratuita con Inizio Impresa."
>
  <!-- APERTURA -->
  <section class="apertura">
    <div class="contenitore apertura-griglia">
      <div>
        <span class="pillola">Sei un venditore?</span>
        <h1>Vendi beni strumentali alle <span class="evidenza">aziende</span>?</h1>
        <p class="sottotitolo">
          Aumenta le tue vendite con le nostre soluzioni finanziarie: <strong>leasing, noleggio
          operativo, finanziamenti aziendali e finanza agevolata</strong> per i tuoi clienti.
        </p>
        <div class="azioni">
          <a href="#modulo" class="bottone bottone--pieno">Collabora con noi</a>
          <a href="#soluzioni" class="collegamento">Scopri le soluzioni →</a>
        </div>
        <ul class="spunte">
          <li>Collaborazione gratuita</li>
          <li>Incassi tutto e subito</li>
          <li>Assistenza per te e i tuoi clienti</li>
        </ul>
      </div>
      <div class="cifre" aria-label="La collaborazione in breve">
        <div class="cifra cifra--grande"><strong>Gratis</strong><span>3 diverse modalità di collaborazione, completamente gratuite</span></div>
        <div class="cifra"><strong>42</strong><span>istituti bancari con cui collaboriamo</span></div>
        <div class="cifra"><strong>Subito</strong><span>incassi tutto, anche se il cliente paga a rate</span></div>
        <div class="cifra cifra--scura"><strong>Supporto continuo</strong><span>assistenza per te e per i tuoi clienti</span></div>
      </div>
    </div>
  </section>

  <!-- BENEFICI -->
  <section class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Come possiamo supportarti?</span>
        <h2>I tuoi benefici</h2>
        <p>
          Che tu sia un venditore esperto o alle prime armi, Inizio Impresa ti dà gli strumenti per
          raggiungere i tuoi obiettivi e rispondere alle esigenze dei tuoi clienti.
        </p>
      </div>
      <ul class="griglia griglia--4 benefici" role="list">
        {benefici.map((b) => (
          <li class="scheda">
            <div class="icona"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={b.icona} /></div>
            <h3>{b.titolo}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SOLUZIONI -->
  <section id="soluzioni" class="sezione">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Al fianco delle imprese</span>
        <h2>Cosa puoi offrire ai tuoi clienti</h2>
        <p>Vendi con soluzioni diverse, ma incassi sempre tutto e subito.</p>
      </div>
      <div class="griglia griglia--2">
        {soluzioni.map((s, i) => (
          <div class="scheda">
            <div class="icona icona--notte"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icona} /></div>
            <h3>{i + 1}. {s.titolo}</h3>
            <p>{s.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PERCHE NOI SE HAI GIA UN PARTNER -->
  <section class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Perché scegliere noi</span>
        <h2>Hai già un partner finanziario?</h2>
        <p>Ecco cosa ti diamo in più.</p>
      </div>
      <div class="griglia griglia--3">
        {motivi.map((m) => (
          <div class="scheda">
            <div class="icona"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg></div>
            <h3>{m.titolo}</h3>
            <p>{m.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Storie
    titolo="Imprese che hanno investito con noi"
    testo="Alcune delle attività che abbiamo aiutato a ottenere fondi per crescere."
  />

  <Numeri />

  <Perche />

  <Modulo
    id="Sb7fiVc2IGHPPsXtuCSk"
    nome="Modulo Sito Inizio Impresa - Gen. Finanza Ag."
    titolo="Collabora con noi"
    spunte={["Collaborazione gratuita", "Un referente dedicato", "Risposta rapida"]}
    testo="Lasciaci i tuoi dati: ti spieghiamo le modalità di collaborazione, tutte gratuite, e come offrire le nostre soluzioni finanziarie ai tuoi clienti."
  />
</Base>

<style>
  .apertura { padding: 72px 0 88px; }
  .apertura-griglia { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .apertura h1 { margin: 20px 0; font-size: clamp(34px, 5.4vw, 60px); }
  .sottotitolo { font-size: 18px; max-width: 540px; }
  .sottotitolo strong { color: var(--testo); }
  .azioni { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin: 32px 0 20px; }

  .cifre {
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 32px;
    border-radius: 28px; background: linear-gradient(160deg, #fdf3f3 0%, #f1f2f7 100%);
  }
  .cifra {
    background: #fff; border: 1px solid var(--bordo); border-radius: 16px; padding: 20px;
    box-shadow: var(--ombra); display: flex; flex-direction: column; gap: 4px; font-size: 14px;
    min-width: 0;
  }
  .cifra strong { font-family: var(--font-titoli); font-weight: 600; font-size: 24px; color: var(--testo); line-height: 1.1; }
  .cifra--grande { grid-column: 1 / -1; }
  .cifra--grande strong { font-size: 56px; color: var(--rosso); }
  .cifra--scura { grid-column: 1 / -1; background: var(--notte); border-color: var(--notte); color: #c9cad6; }
  .cifra--scura strong { color: #fff; }

  .benefici { list-style: none; margin: 0; padding: 0; }
  .benefici .scheda { display: flex; align-items: center; gap: 16px; padding: 22px; }
  .benefici .icona { margin-bottom: 0; flex: none; }
  .benefici h3 { margin: 0; font-size: 17px; }

  @media (max-width: 960px) {
    .apertura-griglia { grid-template-columns: 1fr; gap: 40px; }
    .apertura { padding: 48px 0 64px; }
  }
  @media (max-width: 520px) {
    .cifre { padding: 18px; }
    .cifra { padding: 16px; }
    .cifra strong { font-size: 21px; }
    .cifra--grande strong { font-size: 44px; }
  }
</style>
