---
// INIZIO IMPRESA PRO. Testi dal vecchio sito (contenuti-originali/inizio-impresa-pro.md),
// accorciati e riordinati. Tolti: il video YouTube incorporato accanto a "A chi è rivolto",
// le storie e i numeri ripetuti due volte, la sezione "Dove siamo" (i contatti sono nel piede).
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Modulo from '../../components/Modulo.astro';
import Numeri from '../../components/Numeri.astro';
import Storie from '../../components/Storie.astro';
import consulente from '../../assets/consulente.png';
import pratica1 from '../../assets/inizio-impresa-pro/pratica-approvata-1.png';
import pratica2 from '../../assets/inizio-impresa-pro/pratica-approvata-2.png';
import pratica3 from '../../assets/inizio-impresa-pro/pratica-approvata-3.png';
import pratica4 from '../../assets/inizio-impresa-pro/pratica-approvata-4.png';
import pratica5 from '../../assets/inizio-impresa-pro/pratica-approvata-5.png';

const pratiche = [pratica1, pratica2, pratica3, pratica4, pratica5];

const vantaggi = [
  {
    titolo: '4 call online',
    testo: "Un incontro ogni tre mesi, di 30–45 minuti, per analizzare la situazione dell'azienda e le opportunità disponibili.",
    icona: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/>',
  },
  {
    titolo: 'Radar bandi personalizzato',
    testo: "Aggiornamenti su misura sui bandi e sulle agevolazioni più in linea con il profilo dell'impresa.",
    icona: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><path d="M12 12l6-6"/>',
  },
  {
    titolo: 'Report strategico',
    testo: 'Un documento dedicato dopo ogni call, con indicazioni operative e prossimi passi.',
    icona: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
  },
  {
    titolo: 'Follow up continuo',
    testo: "Supporto costante tra un incontro e l'altro, per accompagnare l'azienda nel percorso.",
    icona: '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/>',
  },
  {
    titolo: 'Accesso prioritario',
    testo: 'Corsia preferenziale nelle nostre campagne di finanza agevolata.',
    icona: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  },
  {
    titolo: 'Programma rinnovabile',
    testo: 'Alla fine di ogni anno puoi rinnovare, mantenere il referente dedicato e ricevere aggiornamenti esclusivi sulle nuove opportunità.',
    icona: '<path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3"/><path d="M18 3v4h-4M6 21v-4h4"/>',
  },
];

const domande = [
  {
    domanda: 'Perché è gratuito? Qual è il "trucco"?',
    risposta:
      "Nessun trucco. Il programma è pensato per aziende strutturate che vogliono investire nel breve periodo. Quando emergono opportunità concrete (bandi, finanza agevolata, leasing, credito d'imposta), l'azienda sceglie liberamente se proseguire con noi su un progetto operativo.",
  },
  {
    domanda: 'Cosa succede dopo la candidatura?',
    risposta:
      "Analizziamo i requisiti e le informazioni ricevute. Se l'azienda è in linea con il programma, la contattiamo per un primo confronto.",
  },
  {
    domanda: "È adatto anche se non ho ancora scelto l'investimento?",
    risposta:
      "Sì. Impresa Pro è utile anche in fase preliminare: ti aiuta a capire quali investimenti sono compatibili con le agevolazioni e come pianificarli, evitando errori che possono precludere l'accesso ai fondi.",
  },
  {
    domanda: 'Impresa Pro è diverso dal classico "monitoraggio bandi"?',
    risposta:
      "Sì, non è un servizio generico. È un percorso strutturato, con call strategiche, report operativi e affiancamento continuo, per aiutare l'impresa a pianificare investimenti compatibili con le agevolazioni.",
  },
];
---
<Base
  titolo="Inizio Impresa Pro · Programma gratuito di finanza agevolata · Inizio Impresa"
  descrizione="Inizio Impresa Pro è un programma gratuito, su selezione, per aziende che vogliono pianificare investimenti e accedere a fondi pubblici e contributi a fondo perduto."
>
  <!-- APERTURA -->
  <section class="apertura">
    <div class="contenitore apertura-griglia">
      <div>
        <span class="pillola">Consulenza strategica per la tua azienda</span>
        <h1>Inizio Impresa <span class="evidenza">Pro</span></h1>
        <p class="sottotitolo">
          Un programma <strong>gratuito</strong>, riservato a un gruppo selezionato di aziende, per guidarti
          nell'accesso a fondi pubblici, contributi a fondo perduto e strumenti agevolati.
        </p>
        <div class="azioni">
          <a href="#modulo" class="bottone bottone--pieno">Candidati gratuitamente</a>
          <a href="#vantaggi" class="collegamento">Come funziona →</a>
        </div>
        <ul class="spunte">
          <li>Programma gratuito</li>
          <li>Un incontro ogni tre mesi</li>
          <li>Accesso su selezione</li>
        </ul>
      </div>
      <div class="cifre" aria-label="Il programma in breve">
        <div class="cifra cifra--grande"><strong>4 incontri</strong><span>strategici all'anno, uno ogni tre mesi</span></div>
        <div class="cifra"><strong>500 mila €</strong><span>fatturato minimo dell'azienda</span></div>
        <div class="cifra"><strong>6–12 mesi</strong><span>orizzonte dei nuovi investimenti</span></div>
        <div class="cifra cifra--scura"><strong>30 aziende</strong><span>ammesse per questa edizione</span></div>
      </div>
    </div>
  </section>

  <!-- DI COSA SI TRATTA -->
  <section class="sezione sezione--tenue">
    <div class="contenitore testata testata--centro" style="margin-bottom:0">
      <span class="occhiello">Di cosa si tratta</span>
      <h2>Prepararsi <span class="evidenza">prima</span> che i bandi escano.</h2>
      <p>
        Con quattro incontri strategici all'anno ti accompagniamo nell'individuare i bandi a cui puoi accedere,
        nel prepararti con anticipo alle opportunità in arrivo e nel pianificare investimenti pienamente
        compatibili con le agevolazioni.
      </p>
    </div>
  </section>

  <!-- A CHI È RIVOLTO -->
  <section class="sezione">
    <div class="contenitore rivolto">
      <div>
        <span class="occhiello">Strategia e pianificazione</span>
        <h2>A chi è rivolto?</h2>
        <p class="rivolto-testo">
          Il programma è dedicato alle aziende con un <strong>fatturato superiore a 500.000 €</strong> che
          intendono <strong>realizzare nuovi investimenti nei prossimi 6–12 mesi</strong> e vogliono accedere
          ai fondi pubblici in modo consapevole, strategico e strutturato.
        </p>
        <p class="rivolto-testo">
          È indicato soprattutto per le realtà che <strong>non hanno un ufficio interno dedicato alla finanza
          agevolata</strong> e vogliono un supporto qualificato per orientarsi tra agevolazioni, bandi e
          opportunità disponibili.
        </p>
        <a href="#modulo" class="bottone bottone--notte">Verifica se puoi accedere</a>
      </div>
      <Image src={consulente} alt="Una consulente di Inizio Impresa" widths={[400, 700]} sizes="(max-width: 960px) 100vw, 480px" class="foto-rivolto" />
    </div>
  </section>

  <!-- I VANTAGGI -->
  <section id="vantaggi" class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Struttura del programma</span>
        <h2>I vantaggi di Inizio Impresa Pro</h2>
        <p>
          Un percorso strutturato di analisi, strategia e supporto continuo per aziende che vogliono
          pianificare investimenti e agevolazioni con metodo.
        </p>
      </div>
      <div class="griglia griglia--3">
        {vantaggi.map((v) => (
          <div class="scheda">
            <div class="icona"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={v.icona} /></div>
            <h3>{v.titolo}</h3>
            <p>{v.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Storie titolo="Alcune attività che ci hanno scelto" />

  <!-- RISULTATI -->
  <section class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Risultati tangibili</span>
        <h2>Alcuni dei nostri risultati</h2>
        <p>Estratti di pratiche, su diverse agevolazioni, approvate con esito positivo.</p>
      </div>
      <ul class="pratiche" role="list">
        {pratiche.map((p, i) => (
          <li>
            <Image src={p} alt={`Estratto della pratica approvata n. ${i + 1}: esito positivo e importo ammesso`} widths={[260, 520]} sizes="(max-width: 960px) 60vw, 210px" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COME CANDIDARSI -->
  <section class="sezione">
    <div class="contenitore">
      <div class="offerta">
        <div>
          <span class="occhiello occhiello--chiaro">Posti limitati</span>
          <h2>Come candidarsi</h2>
          <p>
            Per questa edizione sono ammesse solo 30 aziende. L'accesso avviene su selezione, in base ai
            requisiti e agli obiettivi di investimento.
          </p>
        </div>
        <a href="#modulo" class="bottone bottone--chiaro">Invia la candidatura</a>
      </div>
    </div>
  </section>

  <!-- DOMANDE -->
  <section class="sezione sezione--tenue">
    <div class="contenitore">
      <div class="testata">
        <span class="occhiello">Al fianco delle imprese</span>
        <h2>Domande frequenti</h2>
      </div>
      <div class="domande">
        {domande.map((d) => (
          <details class="domanda">
            <summary>{d.domanda}</summary>
            <p>{d.risposta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Numeri />

  <Modulo
    id="ErtpoEDGvWSavyeEBldm"
    nome="Modulo Sito Inizio Impresa - Inizio Impresa Pro"
    titolo="Compila il modulo e invia la tua candidatura"
    testo="Lasciaci i tuoi dati e scopri gratuitamente se anche la tua azienda può accedere a Inizio Impresa Pro."
  />
</Base>

<style>
  .apertura { padding: 72px 0 88px; }
  .apertura-griglia { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .apertura h1 { margin: 20px 0; font-size: clamp(40px, 6.4vw, 68px); }
  .sottotitolo { font-size: 18px; max-width: 520px; }
  .sottotitolo strong { color: var(--testo); }
  .azioni { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin: 32px 0 20px; }

  .cifre {
    display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 32px;
    border-radius: 28px; background: linear-gradient(160deg, #fdf3f3 0%, #f1f2f7 100%);
  }
  .cifra {
    background: #fff; border: 1px solid var(--bordo); border-radius: 16px; padding: 20px;
    box-shadow: var(--ombra); display: flex; flex-direction: column; gap: 4px; font-size: 14px;
  }
  .cifra strong { font-family: var(--font-titoli); font-weight: 600; font-size: 24px; color: var(--testo); line-height: 1.1; }
  .cifra--grande { grid-column: 1 / -1; }
  .cifra--grande strong { font-size: 48px; color: var(--rosso); }
  .cifra--scura { grid-column: 1 / -1; background: var(--notte); border-color: var(--notte); color: #c9cad6; }
  .cifra--scura strong { color: #fff; }

  .rivolto { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; }
  .rivolto h2 { margin-bottom: 16px; }
  .rivolto-testo { font-size: 17px; margin-bottom: 14px; }
  .rivolto-testo strong { color: var(--testo); }
  .rivolto .bottone { margin-top: 14px; }
  .foto-rivolto { width: 100%; max-width: 480px; justify-self: end; border-radius: 28px; aspect-ratio: 1; object-fit: cover; }

  .pratiche { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; list-style: none; margin: 0; padding: 0; }
  .pratiche li { border-radius: var(--raggio-piccolo); overflow: hidden; border: 1px solid var(--bordo); background: #fff; }
  .pratiche img { width: 100%; height: auto; }

  .offerta {
    display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;
    padding: 48px; border-radius: 28px; background: var(--rosso); color: #fff;
  }
  .offerta > div { max-width: 640px; }
  .offerta h2 { color: #fff; }
  .offerta p { margin-top: 14px; color: #fff3f3; font-size: 17px; }
  .occhiello--chiaro { color: #ffe1e1; }

  .domande { display: grid; gap: 12px; max-width: 820px; }
  .domanda { background: #fff; border: 1px solid var(--bordo); border-radius: var(--raggio-piccolo); padding: 0 22px; }
  .domanda summary {
    cursor: pointer; list-style: none; padding: 18px 28px 18px 0; position: relative;
    font-family: var(--font-titoli); font-weight: 600; color: var(--testo); font-size: 16px;
  }
  .domanda summary::-webkit-details-marker { display: none; }
  .domanda summary::after {
    content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    font-size: 22px; color: var(--rosso);
  }
  .domanda[open] summary::after { content: '–'; }
  .domanda p { padding-bottom: 20px; }

  @media (max-width: 960px) {
    .apertura-griglia, .rivolto { grid-template-columns: 1fr; gap: 40px; }
    .apertura { padding: 48px 0 64px; }
    .foto-rivolto { justify-self: start; }
    .pratiche {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 60%;
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin: 0 -20px; padding: 0 20px;
    }
    .pratiche::-webkit-scrollbar { display: none; }
    .pratiche li { scroll-snap-align: start; }
  }
  @media (max-width: 520px) {
    .cifre { padding: 18px; }
    .cifra--grande strong { font-size: 40px; }
    .offerta { padding: 32px 24px; }
  }
</style>
